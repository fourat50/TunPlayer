Depends: python3 (>= 3.10), python3-gi, python3-cairo, python3-gi-cairo, gir1.2-gtk-3.0, librsvg2-common, libmpv2 (>= 0.35) | libmpv1 (>= 0.34), ffmpeg, ca-certificates
